server {
    listen 80;
    server_name localhost;

    root /usr/share/nginx/html;
    index index.html;

    # Security headers (single set; X-XSS-Protection is deprecated and omitted)
    # SEOAI:SECURITY-HEADERS:START
add_header X-Frame-Options "SAMEORIGIN" always;
add_header X-Content-Type-Options "nosniff" always;
add_header Referrer-Policy "strict-origin-when-cross-origin" always;
add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
add_header Content-Security-Policy-Report-Only "default-src 'self'; report-uri /csp-report" always;
# SEOAI:SECURITY-HEADERS:END

    # Gzip compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml text/javascript application/javascript application/json application/xml image/svg+xml;

    # EdgeX lead form proxy — keeps EDGEX_API_KEY server-side only, out of client JS.
    # Env vars are injected at container start via nginx's built-in envsubst-on-templates
    # entrypoint (docker-entrypoint.d/20-envsubst-on-templates.sh), which only substitutes
    # names that exist in the container environment, so nginx's own $variables are untouched.
    location = /api/lead/contact-us {
        limit_except POST { deny all; }
        proxy_pass https://edgex.zunkireelabs.com/api/public/submit/chayce-properties/contact-us;
        proxy_ssl_server_name on;
        proxy_set_header Host edgex.zunkireelabs.com;
        proxy_set_header Authorization "Bearer ${EDGEX_API_KEY}";
        proxy_set_header Content-Type "application/json";
    }

    location = /api/lead/get-started {
        limit_except POST { deny all; }
        proxy_pass https://edgex.zunkireelabs.com/api/public/submit/chayce-properties/get-started;
        proxy_ssl_server_name on;
        proxy_set_header Host edgex.zunkireelabs.com;
        proxy_set_header Authorization "Bearer ${EDGEX_API_KEY}";
        proxy_set_header Content-Type "application/json";
    }

    # ---- Legacy URL clean-up (prior site on this domain) -------------------
    # Google keeps retrying a 404 for weeks; a 410 says "permanently gone" and
    # it drops the URL (and the unrelated queries it ranked for) much faster.
    # These paths belong to the previous WordPress/WooCommerce site and never
    # existed in this one. Do NOT also Disallow them in robots.txt: a blocked
    # URL can't be recrawled, so Google would never see the 410.
    # Placed before the static-asset block so /shop/x.jpg is also a 410.
    location ~* ^/(shop|product|products|product-category|product-tag|cart|checkout|my-account|wp-admin|wp-content|wp-includes|wp-json|tag|category|author|feed|comments|sales-team|certificates|photo-gallery|about-chayce-v2)(/|$) {
        return 410;
    }
    location ~* \.php$ {
        return 410;
    }
    error_page 410 /404.html;

    # Old HTML-template paths that now have a direct equivalent: 301 so any
    # ranking signal and backlinks carry over to the new page.
    location ~ ^/our-services/?$ { return 301 https://$host/services/; }
    location ~ ^/news/?$         { return 301 https://$host/blog/; }
    location ~ ^/faq/?$          { return 301 https://$host/senior-moving-faq/; }

    # Pages merged into existing ones (no separate page any more).
    location ~ ^/(home-moving-service-uk|home-removals-for-elderly|packing-and-unpacking-service|declutter-and-sorting-service)/?$ { return 301 https://$host/downsizing-help-for-elderly/; }
    location ~ ^/(what-is-chayce-properties|chayce-vs-standard-removals-company|press)/?$ { return 301 https://$host/about-chayce/; }
    location ~ ^/later-life-moving-glossary/?$ { return 301 https://$host/senior-moving-faq/; }

    # Four regional pages consolidated into one "Areas We Cover" page; each
    # old URL lands on its own section.
    location ~ ^/relocating-to/london-south-east/?$   { return 301 "https://$host/areas-we-cover/#london-south-east"; }
    location ~ ^/relocating-to/home-counties/?$       { return 301 "https://$host/areas-we-cover/#home-counties"; }
    location ~ ^/relocating-to/south-west-coast/?$    { return 301 "https://$host/areas-we-cover/#south-west-coast"; }
    location ~ ^/relocating-to/cotswolds-midlands/?$  { return 301 "https://$host/areas-we-cover/#cotswolds-midlands"; }
    location ~ ^/relocating-to/?$                     { return 301 https://$host/areas-we-cover/; }

    # Overlapping blog posts merged into a single owner post.
    location ~ ^/blog/removals-cost-for-older-people-uk/?$ { return 301 https://$host/blog/senior-move-cost-uk/; }
    location ~ ^/blog/questions-to-ask-a-removals-company-uk/?$ { return 301 https://$host/blog/choosing-removals-company-for-elderly-person-uk/; }
    location ~ ^/blog/choosing-relocation-partner-uk-move/?$ { return 301 https://$host/blog/choosing-removals-company-for-elderly-person-uk/; }
    location ~ ^/blog/downsizing-your-family-home-uk-guide/?$ { return 301 https://$host/blog/downsizing-checklist-what-to-keep-uk/; }
    location ~ ^/blog/what-to-do-with-unwanted-furniture-downsizing-uk/?$ { return 301 https://$host/blog/planning-furniture-and-floor-plan-for-a-smaller-home/; }
    location ~ ^/blog/moving-a-parent-guide-for-adult-children/?$ { return 301 https://$host/moving-elderly-parent/; }
    location ~ ^/blog/retirement-flat-move-checklist-uk/?$ { return 301 https://$host/blog/moving-into-a-retirement-village-uk-guide/; }
    location ~ ^/blog/moving-into-sheltered-housing-what-to-expect/?$ { return 301 https://$host/blog/moving-into-a-retirement-village-uk-guide/; }

    # Duplicate-URL consolidation: try_files below also serves /page.html and
    # /page/index.html, so the same page was reachable at several URLs.
    # $request_uri is the ORIGINAL request, so this never fires on nginx's own
    # internal /page/ -> /page/index.html hop (which would loop).
    if ($request_uri ~ "^/index\.html(\?.*)?$")            { return 301 https://$host/; }
    if ($request_uri ~ "^/(.+)/index\.html(\?.*)?$")       { return 301 https://$host/$1/; }
    if ($request_uri ~ "^/([A-Za-z0-9_/-]+)\.html(\?.*)?$") { return 301 https://$host/$1/; }

    # Static assets — cache aggressively
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|webp|avif)$ {
        expires 30d;
        add_header Cache-Control "public, max-age=2592000, immutable";
    }

    # HTML pages — no cache (always serve fresh content)
    location ~* \.html$ {
        expires -1;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    # Sitemap and robots — short cache
    location ~* (sitemap\.xml|robots\.txt)$ {
        expires 1d;
        add_header Cache-Control "public, max-age=86400";
    }

    # The "h" query param is a confirmed-dead tracking hash inherited from a
    # prior site on this domain — grepped across every page template and
    # every script this site actually owns, it's never read by anything real
    # (unlike ?package=, which get-started.njk genuinely uses). Safe to
    # redirect away outright rather than just canonicalize: a 301 is a much
    # stronger, faster consolidation signal to Google than a canonical tag.
    if ($arg_h) {
        # Hardcoded https, not $scheme: this container sits behind a proxy/LB
        # that terminates TLS and forwards plain HTTP internally, so $scheme
        # here always evaluates to "http" regardless of what the visitor
        # actually used — confirmed live: this redirect was sending browsers
        # to http://chayceproperties.com/, a real downgrade bug, not a
        # theoretical one. This site is always served over https.
        return 301 https://$host$uri;
    }

    # Static site routing — try exact file, then directory, then .html extension.
    # A genuinely unmatched path (a legacy URL from a prior site on this domain,
    # a typo, a bot probe) must fall through to a REAL 404 here, not silently
    # serve the homepage with a 200 — that was producing thousands of distinct
    # URLs that all returned identical homepage content, which Google flagged
    # as mass duplication and refused to index (see Search Console's own
    # "Crawled - currently not indexed" count). A real 404/410 is also the only
    # way Google's crawler ever learns a legacy URL is actually gone and drops
    # it from the index — a robots.txt block alone can't do that, since it
    # stops Google from ever recrawling to find out.
    location / {
        try_files $uri $uri/ $uri.html =404;
    }

    error_page 404 /404.html;
    location = /404.html {
        internal;
    }
}
