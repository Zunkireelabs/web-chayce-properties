server {
    listen 80;
    server_name localhost;

    root /usr/share/nginx/html;
    index index.html;

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN";
    add_header X-Content-Type-Options "nosniff";
    add_header X-XSS-Protection "1; mode=block";
    add_header Referrer-Policy "strict-origin-when-cross-origin";
    # SEOAI:SECURITY-HEADERS:START
add_header X-Frame-Options "SAMEORIGIN" always;
add_header X-Content-Type-Options "nosniff" always;
add_header Referrer-Policy "strict-origin-when-cross-origin" always;
add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
add_header Content-Security-Policy-Report-Only "default-src 'self'; report-uri /csp-report" always;
# SEOAI:SECURITY-HEADERS:END

    # Gzip compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml text/javascript application/javascript application/json application/xml image/svg+xml;

    # EdgeX lead form proxy — keeps EDGEX_API_KEY server-side only, out of client JS.
    # Env vars are injected at container start via nginx's built-in envsubst-on-templates
    # entrypoint (docker-entrypoint.d/20-envsubst-on-templates.sh), which only substitutes
    # names that exist in the container environment, so nginx's own $variables are untouched.
    location = /api/lead/contact-us {
        limit_except POST { deny all; }
        proxy_pass https://edgex.zunkireelabs.com/api/public/submit/chayce-properties/contact-us;
        proxy_ssl_server_name on;
        proxy_set_header Host edgex.zunkireelabs.com;
        proxy_set_header Authorization "Bearer ${EDGEX_API_KEY}";
        proxy_set_header Content-Type "application/json";
    }

    location = /api/lead/get-started {
        limit_except POST { deny all; }
        proxy_pass https://edgex.zunkireelabs.com/api/public/submit/chayce-properties/get-started;
        proxy_ssl_server_name on;
        proxy_set_header Host edgex.zunkireelabs.com;
        proxy_set_header Authorization "Bearer ${EDGEX_API_KEY}";
        proxy_set_header Content-Type "application/json";
    }

    # Static assets — cache aggressively
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|webp|avif)$ {
        expires 30d;
        add_header Cache-Control "public, max-age=2592000, immutable";
    }

    # HTML pages — no cache (always serve fresh content)
    location ~* \.html$ {
        expires -1;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    # Sitemap and robots — short cache
    location ~* (sitemap\.xml|robots\.txt)$ {
        expires 1d;
        add_header Cache-Control "public, max-age=86400";
    }

    # Static site routing — try exact file, then directory, then .html extension.
    # A genuinely unmatched path (a legacy URL from a prior site on this domain,
    # a typo, a bot probe) must fall through to a REAL 404 here, not silently
    # serve the homepage with a 200 — that was producing thousands of distinct
    # URLs that all returned identical homepage content, which Google flagged
    # as mass duplication and refused to index (see Search Console's own
    # "Crawled - currently not indexed" count). A real 404/410 is also the only
    # way Google's crawler ever learns a legacy URL is actually gone and drops
    # it from the index — a robots.txt block alone can't do that, since it
    # stops Google from ever recrawling to find out.
    location / {
        try_files $uri $uri/ $uri.html =404;
    }

    error_page 404 /404.html;
    location = /404.html {
        internal;
    }
}
