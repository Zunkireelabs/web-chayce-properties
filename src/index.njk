---
title: "Chayce Properties | UK Senior Relocation & Downsizing"
description: "Chayce Properties is a relocation partner for senior clients across the UK — packing, removals, downsizing and legal coordination, based in Northampton."
bodyClass: "page-template page-loaded"
homeNav: true
footerPackagesId: true
layout: base.njk
headExtra: |
  <link rel="stylesheet" href="/css/chayce-nav.css">
  <style>
  .chayce-logo-link{text-decoration:none!important}
  html{scroll-behavior:smooth}
  body{color:var(--ink)}
  #footer-packages{scroll-margin-top:24px}
  /* ===== Nav uses the shared glass effect from css/chayce-nav.css (transparent over the hero, blurred glass once scrolled) — same behavior as every other page ===== */
  /* ===== Hero — moving-home imagery, sliding like the live site, one message, one CTA ===== */
  .home-hero{position:relative;min-height:100vh;display:flex;align-items:center;background:var(--ink);overflow:hidden}
  .hero-slide{position:absolute;inset:0;background-size:cover;background-position:center;opacity:0;transition:opacity 1.2s ease;z-index:0}
  .hero-slide.active{opacity:1}
  .home-hero::before{content:'';position:absolute;inset:0;background:linear-gradient(180deg,rgba(18,20,26,.4) 0%,rgba(18,20,26,.6) 100%),radial-gradient(60% 65% at 50% 45%,rgba(10,11,15,.62) 0%,rgba(10,11,15,.28) 60%,rgba(10,11,15,0) 100%);z-index:1}
  .home-hero .container{position:relative;z-index:2;text-align:center;display:flex;flex-direction:column;align-items:center;margin-top:160px}
  .home-hero h1,.home-hero p.lead{transition:opacity .5s ease}
  .hero-dots{display:flex;gap:10px;margin-top:38px;justify-content:center}
  .hero-dots button{width:9px;height:9px;border-radius:50%;border:1px solid rgba(255,255,255,.6);background:transparent;padding:0;cursor:pointer;transition:.2s}
  .hero-dots button.active{background:var(--gold-light);border-color:var(--gold-light)}
  .home-hero h1{color:#fff;font-family:'Playfair Display',serif;font-size:60px;line-height:1.18;font-weight:500;max-width:1020px;margin:0 0 22px;text-shadow:0 3px 18px rgba(0,0,0,.45)}
  .home-hero h1 em{color:var(--gold-light);font-style:normal}
  .home-hero p.lead{color:#f1efe9;font-size:18px;line-height:1.95;max-width:620px;margin:0 auto 48px;text-shadow:0 2px 10px rgba(0,0,0,.4)}
  .hero-actions{display:flex;align-items:center;justify-content:center;gap:30px;flex-wrap:wrap;width:100%}
  .btn-lg{display:inline-block;padding:16px 36px;font-size:16px;letter-spacing:1.5px;text-transform:uppercase;text-decoration:none;font-weight:500;border-radius:2px;font-family:'Poppins',sans-serif;transition:.2s}
  .btn-lg.primary{background:var(--oxblood);color:#fff}
  .btn-lg.primary:hover{background:var(--oxblood-dark);color:#fff}
  .text-link{color:#fff;font-family:'Poppins',sans-serif;font-size:15.5px;font-weight:500;letter-spacing:.4px;text-decoration:none;transition:.2s}
  .text-link i{margin-right:7px}
  .text-link:hover{color:var(--gold-light)}
  .text-link.dark{color:var(--ink)}
  .text-link.dark:hover{color:var(--gold)}
  /* ===== Section rhythm ===== */
  .home-section{padding:80px 0}
  .home-section.tight{padding:56px 0}
  .home-section+.home-section,.home-section+.start-band,.start-band+.home-section,.home-section+.final-cta{padding-top:0}
  .home-section.grey{background:var(--bg-warm)}
  .home-eyebrow{display:block;color:var(--gold-dark);font-family:'Poppins',sans-serif;font-size:13.5px;letter-spacing:3px;text-transform:uppercase;font-weight:500;margin-bottom:16px}
  .home-h2{font-family:'Playfair Display',serif;font-size:38px;color:var(--ink);margin:0 0 18px;line-height:1.3}
  .home-h2 em{color:var(--gold);font-style:normal}
  .body-copy{color:#555;font-size:16.5px;line-height:1.85;max-width:520px;margin:0}
  /* ===== Real client stories ===== */
  .stories-band{background:var(--oxblood)}
  .stories-band .home-eyebrow{color:var(--gold-light)}
  .stories-band .home-h2{color:#fff}
  .stories-grid{display:grid;grid-template-columns:1fr 1fr;gap:26px;margin-top:44px}
  .story-card{position:relative;background:rgba(255,255,255,.045);border:1px solid rgba(255,255,255,.12);padding:38px 36px;display:flex;flex-direction:column;overflow:hidden}
  .story-card.featured{grid-column:1 / -1}
  .story-card .qmark{position:absolute;top:8px;right:24px;font-family:'Playfair Display',serif;font-size:76px;color:rgba(200,169,110,.16);line-height:1;pointer-events:none}
  .story-card p.sc-quote{position:relative;font-family:'Poppins',sans-serif;font-size:16px;line-height:1.85;color:#f2f0eb;margin:0 0 22px;flex:1}
  .story-card.featured p.sc-quote{font-size:18px;max-width:640px}
  .sc-byline{display:flex;align-items:center;gap:13px;margin-bottom:16px}
  .sc-byline .sc-mark{flex:0 0 36px;width:36px;height:36px;border-radius:50%;background:var(--gold);color:var(--ink);font-family:'Poppins',sans-serif;font-weight:500;font-size:14px;font-weight:500;display:flex;align-items:center;justify-content:center}
  .sc-byline .sc-who{display:flex;flex-direction:column}
  .sc-byline .sc-who b{font-size:15.5px;color:#fff;font-weight:500}
  .sc-byline .sc-who span{font-size:13px;color:#a39d92;letter-spacing:.3px}
  .story-card a{font-size:15px;color:var(--gold-light);font-weight:500;text-decoration:none;margin-top:auto;align-self:flex-start}
  .story-card a:hover{color:#fff}
  @media(max-width:900px){.stories-grid{grid-template-columns:1fr}.story-card.featured{grid-column:auto}.story-card.featured p.sc-quote{font-size:17px}}
  /* ===== Intro (editorial, text + image) ===== */
  .intro-row{display:flex;align-items:center;gap:70px}
  .intro-row .copy{flex:1 1 420px}
  .intro-row figure{flex:1 1 420px;margin:0}
  .intro-row img{width:100%;height:300px;object-fit:cover;display:block}
  /* ===== Trust bar — restyled as a badge/pill row (denser trust signal than a thin text line) ===== */
  .trust-bar{background:#fff;border-bottom:1px solid var(--border-light);padding:30px 0}
  .trust-bar .container{display:flex;justify-content:center;align-items:center;gap:16px;flex-wrap:wrap}
  .trust-bar .tb-item{display:flex;align-items:center;gap:10px;padding:11px 22px;border:1px solid var(--border-warm-2);border-radius:30px}
  .trust-bar .tb-item i{color:var(--gold-dark);font-size:15px}
  .trust-bar .tb-item span{font-family:'Poppins',sans-serif;font-size:14px;font-weight:500;color:var(--ink);letter-spacing:.2px}
  /* ===== Value statement — Bishop's Move shape: left-accent heading column + right copy column, a centered contact line, then a dark CTA bar ===== */
  .value-columns{display:flex;gap:24px;align-items:flex-start}
  .value-heading{flex:0 0 auto;border-left:2px solid var(--gold);padding-left:26px}
  .value-heading .home-h2{text-align:left;margin:0;white-space:nowrap;font-size:32px}
  .value-copy{flex:0 1 620px;padding-top:50px}
  .value-copy .body-copy{text-align:left;max-width:none}
  .value-contact{text-align:center;margin-top:32px;color:var(--grey-mid);font-size:16px}
  .value-contact a{color:var(--gold-dark);text-decoration:none;font-weight:500}
  .value-contact a:hover{color:var(--ink)}
  .value-cta-bar{display:flex;align-items:center;justify-content:space-between;gap:24px;max-width:900px;margin:24px auto 0;background:var(--bg-cream-deep);padding:26px 40px}
  .value-cta-bar span{color:var(--ink);font-family:'Poppins',sans-serif;font-size:19px;font-weight:500}
  .value-cta-bar a{flex-shrink:0;background:var(--navy);color:#fff;padding:13px 28px;font-family:'Poppins',sans-serif;font-size:13.5px;font-weight:500;letter-spacing:1.5px;text-transform:uppercase;text-decoration:none}
  .value-cta-bar a:hover{background:var(--navy-dark)}
  /* ===== Service snapshot — bordered tile grid (Bishop's Move's service-card shape), replaces the three-in-a-row-with-connector ===== */
  .svc-tile-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:0;margin-top:56px;border-top:1px solid var(--border-warm);border-left:1px solid var(--border-warm)}
  .svc-tile{padding:40px 34px;border-right:1px solid var(--border-warm);border-bottom:1px solid var(--border-warm)}
  .svc-tile .num{display:flex;align-items:center;justify-content:center;width:52px;height:52px;border-radius:50%;background:transparent;border:1.5px solid var(--gold);font-family:'Poppins',sans-serif;font-size:17px;letter-spacing:1px;color:var(--gold-dark);font-weight:500;margin-bottom:24px}
  .svc-tile h4{font-family:'Poppins',sans-serif;font-weight:500;font-size:23px;color:var(--ink);margin:0 0 12px}
  .svc-tile p{color:var(--grey-mid);font-size:16.5px;line-height:1.8;margin:0}
  /* ===== Areas We Cover — new homepage section (Bishop's Move's local-presence pattern), reusing the site's already-published area pages ===== */
  .areas-grid{display:flex;justify-content:center;gap:0;margin-top:56px}
  .areas-item{flex:1 1 0;max-width:260px;padding:0 28px;text-align:center;border-left:1px solid var(--border-warm)}
  .areas-item:first-child{border-left:none}
  .areas-item .pin{display:inline-flex;align-items:center;justify-content:center;width:44px;height:44px;border-radius:50%;background:var(--ink);color:var(--gold-light);font-size:16px;margin-bottom:16px;transition:background .2s ease}
  .areas-item:hover .pin{background:var(--gold-dark)}
  .areas-item h4{font-family:'Poppins',sans-serif;font-weight:500;font-size:17px;color:var(--ink);margin:0 0 8px;line-height:1.35}
  .areas-item a{color:var(--grey-mid);font-size:15px;text-decoration:none}
  .areas-item a:hover{color:var(--gold)}

  /* ===== Get Started connector — 3-step, right after the process section ===== */
  .start-band{background:var(--bg-warm);padding:64px 0}
  .start-row{display:flex;gap:26px;max-width:980px;margin:36px auto 0}
  .start-item{flex:1 1 0;text-align:center;padding:0 12px}
  .start-item .num{display:inline-flex;align-items:center;justify-content:center;width:44px;height:44px;border-radius:50%;background:var(--ink);color:var(--gold-light);font-family:'Poppins',sans-serif;font-weight:500;font-size:17px;margin-bottom:18px}
  .start-item h4{font-family:'Poppins',sans-serif;font-weight:500;font-size:19px;color:var(--ink);margin:0 0 10px}
  .start-item p{color:var(--grey-mid);font-size:15.5px;line-height:1.65;margin:0}
  .stage-cta{display:inline-flex;align-items:center;gap:9px;margin-top:44px;padding:15px 32px;border:1.5px solid var(--gold);border-radius:32px;background:var(--oxblood);font-family:'Poppins',sans-serif;font-size:14.5px;font-weight:500;letter-spacing:1px;text-transform:uppercase;text-decoration:none;color:#fff;transition:.25s ease}
  .stage-cta:hover{background:var(--oxblood-dark);border-color:var(--ink);color:#fff;gap:13px}
  /* ===== Services preview — refined two-column rows ===== */
  .svc-grid{display:grid;grid-template-columns:1fr 1fr;max-width:900px;margin:44px auto 0;border-top:1px solid var(--border-warm)}
  .svc-card{display:flex;align-items:flex-start;gap:18px;padding:30px 22px;border-bottom:1px solid var(--border-warm)}
  .svc-card:nth-child(odd){border-right:1px solid var(--border-warm)}
  .svc-card .num{flex:0 0 auto;display:flex;align-items:center;justify-content:center;width:42px;height:42px;border-radius:50%;background:transparent;border:1px solid var(--gold);font-family:'Poppins',sans-serif;font-size:14.5px;letter-spacing:1px;color:var(--gold-dark);font-weight:500}
  .svc-card .svc-text{display:flex;flex-direction:column}
  .svc-card .svc-name{display:block;font-family:'Poppins',sans-serif;font-weight:500;font-size:19px;color:var(--ink);margin-bottom:6px}
  .svc-card .svc-desc{display:block;color:var(--grey-mid);font-size:16.5px;line-height:1.7}
  @media(max-width:480px){.svc-grid{grid-template-columns:1fr}.svc-card:nth-child(odd){border-right:none}}
  /* ===== Meet your coordinator — reversed from the intro-row above (media
     right there, left here), header integrated into the copy column
     instead of a separate centered block, so this doesn't read as the
     same "centered intro + row below" formula a third time ===== */
  .coord-feature{display:flex;align-items:center;gap:64px;max-width:1080px;margin:0 auto}
  .coord-feature figure{flex:1 1 44%;margin:0}
  .coord-feature img,.coord-feature video{width:100%;height:420px;object-fit:cover;display:block;border-radius:8px}
  .coord-copy{flex:1 1 52%}
  .coord-copy .home-h2,.coord-copy .body-copy{text-align:left;max-width:none}
  .coord-row{display:flex;flex-direction:column;gap:14px;margin-top:30px}
  .coord-card{display:flex;align-items:center;gap:16px;text-align:left;padding:18px 22px;border:1px solid var(--border-warm-2);border-radius:12px}
  .coord-card .avatar{width:52px;height:52px;border-radius:50%;background:var(--gold);flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:17px;font-weight:500;color:#fff;font-family:'Poppins',sans-serif;font-weight:500}
  .coord-card h5{font-family:'Poppins',sans-serif;font-weight:500;color:var(--ink);margin:0 0 3px;font-size:16px}
  .coord-card p{color:var(--grey-warm);font-size:13px;letter-spacing:1.2px;text-transform:uppercase;margin:0;line-height:1.5}
  /* ===== AI property search — coming soon teaser, highlighted as a featured box ===== */
  .ai-teaser{background:var(--bg-warm);padding-top:110px}
  .ai-teaser-box{position:relative;background:#fff;border:1.5px solid #e8d5a8;border-radius:20px;padding:56px;box-shadow:0 24px 60px rgba(200,169,110,.14),0 2px 10px rgba(26,26,26,.04)}
  .ai-teaser-ribbon{position:absolute;top:-15px;left:56px;background:var(--ink);color:#e6c98a;font-family:'Poppins',sans-serif;font-size:13px;font-weight:500;letter-spacing:2px;text-transform:uppercase;padding:8px 18px;border-radius:20px;box-shadow:0 6px 16px rgba(26,26,26,.18)}
  .ai-teaser-box .intro-row{gap:56px}
  .ai-teaser-box .copy{padding-top:16px}
  .ai-teaser-box figure img{border-radius:12px}
  .ai-teaser .body-copy{margin-bottom:28px}
  .ai-teaser-form{display:flex;gap:14px;max-width:440px}
  .ai-teaser-form input{flex:1 1 auto;padding:15px 18px;border:1.5px solid #ddd6c8;border-radius:2px;background:#fff;color:var(--ink);font-family:'Poppins',sans-serif;font-size:16px}
  .ai-teaser-form input::placeholder{color:#9a9689}
  .ai-teaser-form input:focus{outline:none;border-color:var(--gold)}
  .ai-teaser-form .btn-lg{white-space:nowrap;padding:15px 26px}
  .ai-teaser-success{color:#8a6f2e;font-family:'Poppins',sans-serif;font-size:16.5px;font-weight:500;margin:0}
  /* ===== FAQ — native accordion ===== */
  .home-faq{max-width:760px;margin:40px auto 0}
  .home-faq details{border-bottom:1px solid var(--border-warm-2);padding:20px 0}
  .home-faq summary{cursor:pointer;list-style:none;font-family:'Poppins',sans-serif;font-weight:500;font-size:17px;color:var(--ink);display:flex;justify-content:space-between;align-items:center;gap:16px}
  .home-faq summary::-webkit-details-marker{display:none}
  .home-faq summary::after{content:'+';color:var(--gold);font-size:22px;font-weight:300;flex-shrink:0}
  .home-faq details[open] summary::after{content:'\2212'}
  .home-faq details p{color:var(--grey-mid);font-size:16.5px;line-height:1.75;margin:14px 0 0}
  /* ===== Packages — editorial teaser, not cards ===== */
  .pkg-preview{display:flex;max-width:900px;margin:50px auto 0;border-top:1px solid var(--border-warm)}
  .pkg-preview-item{flex:1 1 0;padding:32px 34px 2px;text-align:center}
  .pkg-preview-item+.pkg-preview-item{border-left:1px solid var(--border-warm)}
  .pkg-preview-item h4{font-family:'Poppins',sans-serif;font-weight:500;font-size:19px;color:var(--ink);margin:0 0 8px;transition:color .2s ease}
  .pkg-preview-item p{color:var(--grey-mid);font-size:15.5px;letter-spacing:.2px;margin:0}
  .pkg-preview-item:hover h4{color:var(--gold)}
  /* ===== Why Chayce — editorial trust layout ===== */
  .why-grid{display:flex;gap:80px;max-width:1100px;margin:0 auto}
  .why-statement{flex:1 1 42%}
  .why-lead{font-family:'Poppins',sans-serif;font-weight:500;font-size:27px;line-height:1.5;color:var(--ink);margin:0 0 20px}
  .why-statement .body-copy{max-width:420px}
  .why-points{flex:1 1 52%;display:flex;flex-direction:column}
  .why-point{padding:22px 0 22px 20px;border-left:2px solid var(--border-warm);transition:border-color .2s ease}
  .why-point:hover{border-left-color:var(--gold)}
  .why-point+.why-point{margin-top:4px}
  .why-point h4{font-family:'Poppins',sans-serif;font-weight:500;font-size:17px;color:var(--ink);margin:0 0 6px;letter-spacing:.2px}
  .why-point p{color:var(--grey-mid);font-size:16px;line-height:1.7;margin:0}
  .why-stats{display:flex;justify-content:center;gap:70px;margin:0 auto;max-width:1100px}
  .why-stats>div{text-align:center}
  .why-stats strong{display:block;font-family:'Poppins',sans-serif;font-weight:500;font-size:34px;color:var(--gold);margin-bottom:6px}
  .why-stats span{display:block;font-family:'Poppins',sans-serif;font-size:13px;letter-spacing:1.6px;text-transform:uppercase;color:var(--grey-warm)}
  /* ===== Final CTA ===== */
  .final-cta{background:var(--bg-cream);padding:100px 0}
  .final-cta .panel{max-width:1120px;margin:0 auto;background:#fff;border-radius:10px;box-shadow:0 30px 70px rgba(20,18,12,.1);display:flex;align-items:center;overflow:hidden}
  .final-cta .txt{flex:1 1 58%;padding:80px 56px 56px}
  .final-cta .home-h2{color:var(--ink);text-align:left;margin:0 0 14px}
  .final-cta p{color:var(--grey-mid);font-size:16px;line-height:1.75;margin:0 0 28px;max-width:420px}
  .final-cta .btn-row{display:flex;gap:16px;flex-wrap:wrap}
  .final-cta .btn-lg.primary{background:var(--oxblood);color:#fff}
  .final-cta .btn-lg.primary:hover{background:var(--oxblood-dark);color:#fff}
  .final-cta .btn-lg.ghost{background:transparent;color:var(--ink);border:1px solid rgba(26,26,26,.3)}
  .final-cta .btn-lg.ghost:hover{background:var(--ink);color:#fff;border-color:var(--ink)}
  .final-cta .img{flex:1 1 42%;align-self:stretch;min-height:420px;background:#111 url(/images/chayce-hero2.jpg) center/cover no-repeat}
  /* ===== Footer redesign ===== */
  .chayce-footer{background:var(--ink);color:var(--footer-text);padding:80px 0 0}
  .chayce-footer .footer-grid{display:grid;grid-template-columns:1.3fr 1fr 1fr 1fr 1.1fr;gap:40px;padding-bottom:60px;border-bottom:1px solid rgba(255,255,255,.1)}
  .chayce-footer h5{font-family:'Poppins',sans-serif;font-size:13px;letter-spacing:2px;text-transform:uppercase;color:var(--grey-warm);margin:0 0 20px}
  .chayce-footer .brand-name{font-family:Georgia,serif;font-size:17px;font-weight:500;letter-spacing:2.5px;color:#fff;margin:0 0 14px;display:block}
  .chayce-footer .brand-desc{font-size:16px;line-height:1.8;color:var(--footer-text-dim);max-width:280px}
  .chayce-footer ul{list-style:none;margin:0;padding:0}
  .chayce-footer ul li{margin-bottom:12px}
  .chayce-footer ul a{color:var(--footer-text);text-decoration:none;font-size:16.5px}
  .chayce-footer ul a:hover{color:var(--gold-light)}
  .chayce-footer .cta-link{color:var(--gold-light);font-weight:500;font-size:16.5px;text-decoration:none;display:inline-block;margin-top:4px}
  .chayce-footer .cta-link:hover{color:var(--gold-light)}
  .chayce-footer address{font-style:normal;color:var(--footer-text-dim);font-size:16.5px;line-height:1.9;margin-bottom:6px}
  .chayce-footer .contact-line{color:var(--footer-text);font-size:16.5px;margin:2px 0}
  .chayce-footer .contact-line a{color:var(--footer-text);text-decoration:none}
  .chayce-footer .contact-line a:hover{color:var(--gold-light)}
  .footer-bottom-row{display:flex;justify-content:space-between;align-items:center;padding:26px 0;font-size:14.5px;color:var(--grey-warm);flex-wrap:wrap;gap:10px}
  @media(max-width:991px){
    .chayce-footer .footer-grid{grid-template-columns:1fr 1fr;row-gap:36px}
    .svc-tile-grid{grid-template-columns:1fr 1fr}
    .svc-tile:nth-child(2n){border-right:none}
    .areas-grid{flex-wrap:wrap;row-gap:32px}
    .areas-item{flex:1 1 40%;border-left:none}
    .svc-grid{grid-template-columns:1fr}
    .svc-card:nth-child(odd){border-right:none}
  }
  @media(max-width:767px){
    .home-hero{min-height:90vh}
    .home-hero h1{font-size:34px}
    .home-hero p.lead{font-size:16px}
    .home-h2{font-size:26px}
    .home-section{padding:64px 0}
    .home-section.tight{padding:48px 0}
    .intro-row{flex-direction:column;gap:30px}
    .intro-row .copy{flex-basis:auto}
    .intro-row figure{flex-basis:auto}
    .intro-row img{height:240px}
    .svc-tile-grid{grid-template-columns:1fr;margin-top:36px}
    .svc-tile:nth-child(2n){border-right:1px solid var(--border-warm)}
    .value-columns{flex-direction:column;gap:28px}
    .value-heading .home-h2{font-size:24px;white-space:normal}
