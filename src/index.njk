<!-- ============ HERO — sliding, moving-home imagery, one message, one CTA ============ -->
<header class="home-hero" id="heroSlider">
  <div class="hero-slide active" style="background-image:url({% imageUrl "wp-content_uploads_2020_03_section-bg01.jpg" %});{% imageSet "wp-content_uploads_2020_03_section-bg01.jpg" %}"></div>
  <div class="hero-slide" style="background-image:url({% imageUrl "chayce-hero-uk.jpg" %});{% imageSet "chayce-hero-uk.jpg" %};background-position:center 30%"></div>
  <div class="hero-slide" style="background-image:url({% imageUrl "chayce-contact.jpg" %});{% imageSet "chayce-contact.jpg" %}"></div>
  <div class="container">
    <h1 id="heroH1">A simpler way to move into <em>your next chapter.</em></h1>
    <p class="lead" id="heroLead">Chayce manages the journey from preparing your current home to settling into your next one &mdash; every detail taken care of.</p>
    <div class="hero-actions">
      <a href="/get-started/" class="btn-lg primary">Get Started</a>
      <a href="https://wa.me/447708925432" class="text-link" target="_blank" rel="noopener"><i class="fab fa-whatsapp"></i> WhatsApp Us</a>
    </div>
    <div class="hero-dots" id="heroDots">
      <button class="active" data-i="0" aria-label="Slide 1"></button>
      <button data-i="1" aria-label="Slide 2"></button>
      <button data-i="2" aria-label="Slide 3"></button>
    </div>
  </div>
</header>

<!-- ============ TRUST BAR — short, honest, already-published facts ============ -->
<div class="trust-bar">
  <div class="container">
    <span class="tb-item"><i class="fas fa-user-check"></i><span>One Coordinator, Every Move</span></span>
    <span class="tb-item"><i class="fas fa-shield-alt"></i><span>Fully Insured</span></span>
    <span class="tb-item"><i class="fas fa-comments"></i><span>Discovery Consultation from &pound;150</span></span>
  </div>
</div>
<script>
(function(){
  var slides = [
    { h1: 'A simpler way to move into <em>your next chapter.</em>', lead: 'Chayce manages the journey from preparing your current home to settling into your next one &mdash; every detail taken care of.' },
    { h1: 'Guiding your family, <em>every step of the way.</em>', lead: 'From sorting and packing to selling and settling in &mdash; we manage it all, so you don&rsquo;t have to.' },
    { h1: 'One coordinator, <em>start to finish.</em>', lead: 'The same person handles your move from first enquiry to settling in &mdash; not a different team at every stage.' }
  ];
  var i = 0;
  var slideEls = document.querySelectorAll('#heroSlider .hero-slide');
  var dotEls = document.querySelectorAll('#heroDots button');
  var h1El = document.getElementById('heroH1');
  var leadEl = document.getElementById('heroLead');
  var timer;

  function show(next){
    i = next;
    slideEls.forEach(function(s, idx){ s.classList.toggle('active', idx === i); });
    dotEls.forEach(function(d, idx){ d.classList.toggle('active', idx === i); });
    h1El.style.opacity = 0;
    leadEl.style.opacity = 0;
    setTimeout(function(){
      h1El.innerHTML = slides[i].h1;
      leadEl.innerHTML = slides[i].lead;
      h1El.style.opacity = 1;
      leadEl.style.opacity = 1;
    }, 250);
  }
  function next(){ show((i + 1) % slides.length); }
  function restart(){ clearInterval(timer); timer = setInterval(next, 5500); }

  dotEls.forEach(function(d){
    d.addEventListener('click', function(){ show(parseInt(d.dataset.i, 10)); restart(); });
  });
  restart();
})();
</script>

