<section class="ref-sec" id="refer">
  <div class="container ref-grid">
    <div class="ref-side">
      <span class="gd-eyebrow" style="text-align:left">Refer a client</span>
      <h2>How do I <em>refer someone?</em></h2>
      <ol class="ref-steps">
        <li><span>1</span><div><b>Ask first</b>Check that the person, or the family member helping them, is happy for you to pass on their details.</div></li>
        <li><span>2</span><div><b>Send the form</b>It takes a minute. Share only what they have agreed to.</div></li>
        <li><span>3</span><div><b>We get in touch</b>We contact the person or their family and talk through what they need, with no obligation.</div></li>
      </ol>
      <div class="ref-call">
        <i class="fas fa-phone" aria-hidden="true"></i>
        <div><b>Prefer to talk it through?</b><a href="tel:{{ site.telephone }}">{{ site.telephoneDisplay }}</a><small>Monday to Friday, {{ site.openingHours.opens }} to {{ site.openingHours.closes }}</small></div>
      </div>
    </div>
    <div class="ref-form-panel">
      <h3 class="ref-form-title">Referral form</h3>
      <form id="refForm" class="ref-form">
        <div class="ref-row">
          <div class="form-group"><label for="rf-name">Your name</label><input id="rf-name" type="text" required autocomplete="name"></div>
          <div class="form-group"><label for="rf-org">Organisation</label><input id="rf-org" type="text" required autocomplete="organization"></div>
        </div>
        <div class="ref-row">
          <div class="form-group"><label for="rf-role">Your role</label>
            <select id="rf-role" required>
              <option value="">Choose one</option>
              <option value="care_home">Care home</option>
              <option value="retirement_village">Retirement village or housing</option>
              <option value="solicitor">Solicitor</option>
              <option value="estate_agent">Estate agent</option>
              <option value="social_worker">Social worker or discharge team</option>
              <option value="charity_or_community">Charity or community group</option>
              <option value="other">Other</option>
            </select>
          </div>
          <div class="form-group"><label for="rf-phone">Your phone</label><input id="rf-phone" type="tel" autocomplete="tel"></div>
        </div>
        <div class="form-group"><label for="rf-email">Your email</label><input id="rf-email" type="email" required autocomplete="email"></div>
        <div class="form-group"><label for="rf-message">About the move</label><textarea id="rf-message" placeholder="Where they are moving from and to, rough timing, and the best way to reach them or their family. Please only share what they have agreed to." required></textarea></div>
        <div class="form-check"><input id="rf-consent" type="checkbox" required><label for="rf-consent">The person, or the family member helping them, has agreed that I can share these details with Chayce.</label></div>
        <button type="submit" class="ref-submit">Send referral</button>
        <p class="form-hint">We use these details only to contact the person about their move. See our <a href="/privacy-policy/">privacy policy</a>.</p>
      </form>
    </div>
  </div>
</section>


<script>
(function(){
  var form = document.getElementById('refForm');
  if (!form) return;
  function splitName(full){
    var parts = full.trim().replace(/\s+/g, ' ').split(' ');
    return { first_name: parts[0] || '', last_name: parts.length > 1 ? parts.slice(1).join(' ') : '' };
  }
  form.addEventListener('submit', function(e){
    e.preventDefault();
    var name = splitName(document.getElementById('rf-name').value);
    var role = document.getElementById('rf-role').value;
    var body = {
      first_name: name.first_name,
      last_name: name.last_name,
      email: document.getElementById('rf-email').value.trim(),
      phone: document.getElementById('rf-phone').value.trim(),
      custom_fields: {
        lead_source: 'professional_referral',
        heard_about_us: 'professional_referral',
        referrer_organisation: document.getElementById('rf-org').value.trim(),
        referrer_role: role,
        message: document.getElementById('rf-message').value.trim()
      },
      idempotency_key: (window.crypto && crypto.randomUUID) ? crypto.randomUUID() : (Date.now() + '-' + Math.random().toString(36).slice(2))
    };
    var btn = form.querySelector('.ref-submit');
    btn.disabled = true; btn.textContent = 'Sending…';
    fetch('/api/lead/contact-us', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) })
      .then(function(res){
        if (!res.ok) throw new Error('submit failed: ' + res.status);
        if (typeof gtag === 'function') gtag('event', 'generate_lead', { form: 'professional_referral', referrer_role: role });
        form.parentNode.innerHTML = '<h3>Thank you, we have your referral.</h3><p>We will get in touch with the person or their family during office hours ({{ site.openingHoursText }}). If it is urgent, call us on <a href="tel:{{ site.telephone }}">{{ site.telephoneDisplay }}</a>.</p>';
      })
      .catch(function(){
        btn.disabled = false; btn.textContent = 'Send referral';
        var err = form.querySelector('.form-error');
        if (!err) { err = document.createElement('p'); err.className = 'form-error'; form.insertBefore(err, btn); }
        err.innerHTML = 'Something went wrong sending this. Please try again, or call us on <a href="tel:{{ site.telephone }}">{{ site.telephoneDisplay }}</a>.';
      });
  });
})();
</script>
</div>
