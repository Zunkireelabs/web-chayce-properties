eleventyComputed:
  title: "Elderly & House Removals in {{ area.name }} | Chayce"
  description: "Elderly and house removals in {{ area.name }}, {{ area.county }}: packing, downsizing help and insured removals from £995, with one coordinator. {{ site.telephoneDisplay }}"
