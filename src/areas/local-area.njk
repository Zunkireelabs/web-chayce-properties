      <article class="lh-story"><span class="lh-tag">{{ area.moves.package }}</span><h3>{{ area.moves.title }}</h3><p>{{ area.moves.text }}</p><a class="lh-more" href="/case-studies/#{{ area.moves.anchor }}">Read the full client story &rarr;</a></article>
    </div>
    <p class="lh-note">Shared with the client&rsquo;s permission, including naming the town. No names are used on this page.</p>
  </div>
</section>
{% endif %}

