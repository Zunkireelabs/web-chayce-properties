  var elName = document.getElementById('pkgModalName');
  var elCta = document.getElementById('pkgModalCta');
  var elReadMore = document.getElementById('pkgModalReadMore');
  var elList = document.getElementById('pkgModalList');

  function render(id){
    var d = PKG_DATA[id];
    if(!d) return;
    elName.textContent = d.name;
    elCta.textContent = d.cta;
    elCta.href = d.ctaHref;
    elReadMore.href = d.fullHref;
    elList.innerHTML = d.features.map(function(f){
      return '<li><span class="ico-wrap">'+checkIcon+'</span><span>'+f+'</span></li>';
    }).join('');
    var modalEl = overlay.querySelector('.pkg-modal');
    if(modalEl) modalEl.scrollTop = 0;
  }

  function setActiveCard(btn){
    document.querySelectorAll('.pkg-card.active').forEach(function(c){ c.classList.remove('active'); });
    if(btn){
      var card = btn.closest('.pkg-card');
      if(card) card.classList.add('active');
    }
  }

  function openModal(id, btn){
    render(id);
    overlay.classList.add('open');
    setActiveCard(btn);
    overlay.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }
  function closeModal(){
    overlay.classList.remove('open');
    setActiveCard(null);
  }

  document.querySelectorAll('.pkg-detail-link[data-pkg]').forEach(function(btn){
    btn.addEventListener('click', function(e){
      e.stopPropagation();
      openModal(btn.getAttribute('data-pkg'), btn);
    });
  });
  document.getElementById('pkgModalClose').addEventListener('click', closeModal);
  document.addEventListener('keydown', function(e){ if(e.key === 'Escape' && overlay.classList.contains('open')) closeModal(); });
  document.addEventListener('click', function(e){
    if(!overlay.classList.contains('open')) return;
    if(overlay.contains(e.target)) return;
    if(e.target.closest('.pkg-detail-link[data-pkg]')) return;
    closeModal();
  });
})();
</script>

