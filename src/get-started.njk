    {key:'bronze', name:'Bronze Essentials', price:'From £995', href:'../bronze-essentials/',
      blurb:'Professional packing, insured removal, furniture reassembly, light cleaning of the vacated property and a dedicated move coordinator.', tags:BRONZE_TAGS},
    {key:'silver', name:'Silver Comfort', price:'From £1,850', href:'../silver-comfort/',
      blurb:'Everything in Bronze Essentials, plus home sorting, property staging, utility transfers, a deep clean and post-move unpacking.', tags:SILVER_TAGS},
    {key:'gold', name:'Gold Prestige', price:'From £3,250', href:'../gold-prestige/',
      blurb:'Everything in Silver Comfort, plus chauffeur-driven viewings, estate agent liaison, solicitor coordination, full staging with photography, storage and white-glove unpacking.', tags:GOLD_TAGS},
    {key:'platinum', name:'Platinum Bespoke', price:'From £6,500', href:'../platinum-bespoke/',
      blurb:'Everything in Gold Prestige, plus a fully bespoke scope, a personal lifestyle concierge, area orientation, an interior designer consultation and three months of ongoing concierge support.', tags:PLATINUM_TAGS}
  ];
  
  var state = { situation:null, services:[], recommendation:null };
  var steps = ['1','2','3','done']; // step 4 rendered on demand after step 3 continue; kept simple by direct DOM lookups
  var current = '1';
  
  var root = document.querySelector('.gs-wrap');
  var progressEls = root.querySelectorAll('#gsProgress li');
  var stepEls = {};
  root.querySelectorAll('.gs-step').forEach(function(el){ stepEls[el.getAttribute('data-step')] = el; });
  
  function escapeHtml(s){ return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;'); }
  
  function renderSituations(){
    var wrap = document.getElementById('situationChoices');
    wrap.className = 'gs-card-grid';
    wrap.innerHTML = SITUATIONS.map(function(s){
      return '<button type="button" class="gs-card" data-value="'+s.key+'">'+
        '<span class="icon-wrap">'+ICONS[s.icon]+'</span>'+
        '<span class="gs-choice-title">'+s.title+'</span><span class="gs-choice-desc">'+s.desc+'</span>'+
        '<span class="check"></span></button>';
    }).join('');
    wrap.querySelectorAll('.gs-card').forEach(function(btn){
      btn.addEventListener('click', function(){
        wrap.querySelectorAll('.gs-card').forEach(function(b){ b.classList.remove('selected'); });
        btn.classList.add('selected');
        state.situation = btn.getAttribute('data-value');
        state.services = [];
        stepEls['1'].querySelector('[data-next]').disabled = false;
      });
    });
  }
  
  function renderServices(){
    var conf = SITUATION_SERVICES[state.situation];
    var wrap = document.getElementById('serviceChoices');
    var sub = document.getElementById('step2Sub');
    sub.textContent = state.situation === 'unsure'
      ? 'Here is everything Chayce can help with, grouped by stage. Choose anything that sounds relevant — or nothing at all, if you would simply like to talk it through.'
      : 'Select anything that’s relevant — you can choose more than one.';
    var html = '';
    conf.groups.forEach(function(group){
      if (group.label) html += '<div class="gs-group-label">'+group.label+'</div>';
      html += '<div class="gs-card-grid gs-card-grid--sm">';
      group.keys.forEach(function(key){
        var s = SERVICES[key];
        var icon = SERVICE_ICONS[key] ? ICONS[SERVICE_ICONS[key]] : '';
        html += '<button type="button" class="gs-card" data-value="'+key+'">'+
          (icon ? '<span class="icon-wrap">'+icon+'</span>' : '')+
          '<span class="gs-choice-title">'+s.label+'</span><span class="gs-choice-desc">'+s.desc+'</span>'+
          '<span class="check"></span></button>';
      });
      html += '</div>';
    });
    wrap.innerHTML = html;
    wrap.querySelectorAll('.gs-card').forEach(function(btn){
      btn.addEventListener('click', function(){
        var key = btn.getAttribute('data-value');
        var idx = state.services.indexOf(key);
        if (idx > -1) { state.services.splice(idx,1); btn.classList.remove('selected'); }
        else { state.services.push(key); btn.classList.add('selected'); }
        stepEls['2'].querySelector('[data-next]').disabled = state.services.length === 0 && state.situation !== 'unsure';
      });
    });
    // "Not sure" situation may proceed with zero selections
    stepEls['2'].querySelector('[data-next]').disabled = state.situation !== 'unsure';
  }
  
  function packageCoversTags(pkg, tags){
    if (!pkg.tags) return false;
    return tags.every(function(t){ return pkg.tags.indexOf(t) > -1; });
  }
  
  function buildRecommendation(){
    var wrap = document.getElementById('recommendation');
    var refurbNoted = false;
    var tagSet = [];
  
    if (state.situation === 'unsure' || state.services.length === 0) {
      state.recommendation = PACKAGES[0];
      wrap.innerHTML = renderRecCard(PACKAGES[0], null) +
        '<p class="gs-alt">Prefer to skip straight to browsing? <a href="/packages/">See all packages &rarr;</a></p>';
      return;
    }
  
    state.services.forEach(function(key){
      SERVICES[key].tags.forEach(function(t){
        if (t === 'refurbishment') { refurbNoted = true; return; }
        if (tagSet.indexOf(t) === -1) tagSet.push(t);
      });
    });
  
    var match = null;
    for (var i = 1; i < PACKAGES.length; i++) {
      if (packageCoversTags(PACKAGES[i], tagSet)) { match = PACKAGES[i]; break; }
    }
    if (!match) match = PACKAGES[PACKAGES.length - 1];
    state.recommendation = match;
  
    var note = null;
    if (refurbNoted) note = 'Property preparation and refurbishment work isn’t part of a set package — we’d scope that with you directly, alongside whichever level of support fits the rest.';
  
    wrap.innerHTML = renderRecCard(match, note) +
      '<p class="gs-alt">Not quite right, or want to compare everything side by side? <a href="/packages/">See all packages &rarr;</a></p>';
  }
  
  function renderRecCard(pkg, note){
    var html = '<div class="gs-rec"><p class="rec-eyebrow">Likely fit</p><h3>'+pkg.name+'</h3>'+
      '<p class="rec-price">'+pkg.price+'</p>'+
      '<p>'+pkg.blurb+'</p>'+
      '<a class="rec-link" href="/'+pkg.href+'">Full details &rarr;</a></div>';
    if (note) html += '<div class="gs-note">'+note+'</div>';
    return html;
  }
  
  function renderSummary(){
    var situationObj = SITUATIONS.find(function(s){ return s.key === state.situation; });
    var serviceLabels = state.services.map(function(k){ return SERVICES[k].label; });
    var html = '';
    if (situationObj) html += '<strong>Situation:</strong> '+escapeHtml(situationObj.title.replace(/&rsquo;/g,"’"))+'<br>';
    html += '<strong>Looking for help with:</strong> '+(serviceLabels.length ? escapeHtml(serviceLabels.join(', ')) : 'Not sure yet &mdash; happy to discuss')+'<br>';
    if (state.recommendation) html += '<strong>Possible starting point:</strong> '+escapeHtml(state.recommendation.name);
    html += '<br><button type="button" id="gsEditBack">Change my answers</button>';
    document.getElementById('gsSummary').innerHTML = html;
    document.getElementById('gsEditBack').addEventListener('click', function(){ go('1'); });
  
    document.getElementById('gs-situation-field').value = state.situation || '';
    document.getElementById('gs-services-field').value = serviceLabels.join(', ');
    document.getElementById('gs-package-field').value = state.recommendation ? state.recommendation.name : '';
  }
  
  function go(step){
    Object.keys(stepEls).forEach(function(k){ stepEls[k].hidden = (k !== step); });
    root.classList.toggle('is-cards', step === '1' || step === '2');
    current = step;
    var order = ['1','2','3','4'];
    var idx = order.indexOf(step);
    progressEls.forEach(function(li){
      var s = li.getAttribute('data-step');
      var sIdx = order.indexOf(s);
      li.classList.remove('current','done');
      if (s === step) li.classList.add('current');
      else if (sIdx > -1 && idx > -1 && sIdx < idx) li.classList.add('done');
    });
    if (step === 'done') progressEls.forEach(function(li){ li.classList.remove('current'); li.classList.add('done'); });
    root.scrollIntoView({behavior:'smooth', block:'start'});
  }
  
  stepEls['1'].querySelector('[data-next]').addEventListener('click', function(){
    renderServices();
    go('2');
  });
  stepEls['2'].querySelector('[data-back]').addEventListener('click', function(){ go('1'); });
  stepEls['2'].querySelector('[data-next]').addEventListener('click', function(){
    buildRecommendation();
    go('3');
  });
  stepEls['3'].querySelector('[data-back]').addEventListener('click', function(){ go('2'); });
  stepEls['3'].querySelector('[data-next]').addEventListener('click', function(){
    renderSummary();
    go('4');
  });
  stepEls['4'].querySelector('[data-back]').addEventListener('click', function(){ go('3'); });
  function splitName(full){
    var parts = full.trim().replace(/\s+/g, ' ').split(' ');
    return { first_name: parts[0] || '', last_name: parts.length > 1 ? parts.slice(1).join(' ') : '' };
  }

  document.getElementById('gsForm').addEventListener('submit', function(e){
    e.preventDefault();
    var form = this;
    var name = splitName(document.getElementById('gs-name').value);
    var info = document.getElementById('gs-info').value.trim();

    var body = {
      first_name: name.first_name,
      last_name: name.last_name,
      email: document.getElementById('gs-email').value.trim(),
      phone: document.getElementById('gs-phone').value.trim(),
      custom_fields: {
        situation: EDGEX_SITUATION[state.situation] || state.situation,
        services: state.services.map(function(k){ return EDGEX_SERVICE[k] || k; }),
        recommendation: state.recommendation ? (EDGEX_PACKAGE[state.recommendation.key] || state.recommendation.key) : ''
      },
      idempotency_key: (window.crypto && crypto.randomUUID) ? crypto.randomUUID() : (Date.now() + '-' + Math.random().toString(36).slice(2))
    };
    if (info) body.custom_fields.additional_information = info;

    var submitBtn = form.querySelector('[type="submit"]');
    var originalLabel = submitBtn ? submitBtn.textContent : '';
    if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Sending…'; }

    fetch('/api/lead/get-started', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body)
    }).then(function(res){
      if (!res.ok) throw new Error('submit failed: ' + res.status);
      go('done');
    }).catch(function(){
      if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = originalLabel; }
      var err = form.querySelector('.form-error');
      if (!err) {
        err = document.createElement('p');
        err.className = 'form-error';
        err.style.cssText = 'color:#b3261e;font-size:14px;margin:0 0 16px';
        form.insertBefore(err, submitBtn);
      }
      err.innerHTML = 'Something went wrong sending this. Please try again, or call us on ' +
        '<a href="tel:07708925432" style="color:#b3261e;font-weight:600">07708&nbsp;925&nbsp;432</a>.';
    });
  });
  
  renderSituations();
  
  // Arriving from a specific package link (e.g. the packages table) — skip straight
  // to that package's Options step rather than asking the customer to re-explain.
  (function(){
    var params = new URLSearchParams(window.location.search);
    var pkgParam = params.get('package');
    if (!pkgParam) return;
    var found = PACKAGES.find(function(p){ return pkgParam.indexOf(p.name) === 0; });
    if (!found) return;
    state.recommendation = found;
    var wrap = document.getElementById('recommendation');
    wrap.innerHTML = renderRecCard(found, null) +
      '<p class="gs-alt">Prefer to tell us about your situation first instead? <a href="#" id="gsFromScratch">Start from your situation &rarr;</a></p>';
    document.getElementById('gsFromScratch').addEventListener('click', function(e){ e.preventDefault(); go('1'); });
    go('3');
  })();
  })();
  </script>
