---
title: "Get Started | Chayce Properties"
bodyClass: "page-template page-loaded"
homeNav: false
activeKey: "get-started"
layout: base.njk
headExtra: |
  <style>
  .chayce-logo-link{text-decoration:none!important}
  .navbar .container .upper-side .logo{margin-left:80px!important}
  @media(max-width:767px){.navbar .container .upper-side .logo{margin-left:0!important}}
  /* ===== Get Started — guided consultation, not a form. Hero matches homepage home-hero language ===== */
  .gs-hero{position:relative;min-height:520px;display:flex;align-items:center;background:#1a1a1a url(/images/chayce-welcome-hero.jpg) center/cover no-repeat;overflow:hidden}
  .gs-hero::before{content:'';position:absolute;inset:0;background:linear-gradient(100deg,rgba(18,20,26,.82) 0%,rgba(18,20,26,.56) 48%,rgba(18,20,26,.24) 100%)}
  .gs-hero .container{position:relative;z-index:2;padding-top:170px;padding-bottom:50px}
  .gs-hero .breadcrumb{display:block;color:#d8b878;font-family:'Poppins',sans-serif;font-size:13px;letter-spacing:3px;text-transform:uppercase;font-weight:600;margin-bottom:20px}
  .gs-hero .breadcrumb a{color:#e8e6e0;text-decoration:none}
  .gs-hero h1{color:#fff;font-family:'Playfair',serif;font-size:46px;line-height:1.18;font-weight:700;max-width:640px;margin:0 0 18px}
  .gs-hero h1 em{color:#d8b878;font-style:normal}
  .gs-hero p.gs-lead{color:#f0eee8;font-size:18px;line-height:1.8;max-width:540px;margin:0 0 30px}
  .gs-hero .gs-hero-call{display:inline-flex;align-items:center;gap:14px;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.3);padding:14px 24px;border-radius:50px;text-decoration:none;backdrop-filter:blur(2px)}
  .gs-hero .gs-hero-call .ring-icon{width:36px;height:36px;border-radius:50%;background:#c8a96e;display:flex;align-items:center;justify-content:center;color:#fff;flex-shrink:0}
  .gs-hero .gs-hero-call .ring-icon svg{width:17px;height:17px;stroke:currentColor;fill:none;stroke-width:1.8}
  .gs-hero .gs-hero-call .txt{display:flex;flex-direction:column;line-height:1.35}
  .gs-hero .gs-hero-call .txt small{color:#d8d5cc;font-size:12px;letter-spacing:.5px;text-transform:uppercase}
  .gs-hero .gs-hero-call .txt strong{color:#fff;font-size:19px;font-family:'Poppins',sans-serif;font-weight:700}
  .gs-hero .gs-hero-call:hover{background:rgba(255,255,255,.18)}
  /* reassurance strip — makes the page feel guided rather than a bare form */
  .gs-reassure{background:#f9f5ef;border-bottom:1px solid #eee0c8}
  .gs-reassure .container{display:flex;justify-content:center;gap:56px;flex-wrap:wrap;padding:22px 24px;max-width:1140px;margin:0 auto}
  .gs-reassure .item{display:flex;align-items:center;gap:12px;color:#3d3d3d;font-family:'Poppins',sans-serif;font-size:15px;font-weight:600}
  .gs-reassure .item svg{width:22px;height:22px;stroke:#c8a96e;fill:none;stroke-width:1.7;flex-shrink:0}
  @media(max-width:700px){.gs-reassure .container{flex-direction:column;align-items:flex-start;gap:14px;padding:18px 20px}.gs-reassure .item{font-size:14px}}
  .gs-wrap{max-width:720px;margin:0 auto;padding:64px 24px 120px}
  /* progress */
  .gs-progress{display:flex;justify-content:center;gap:0;margin-bottom:64px;list-style:none;padding:0}
  .gs-progress li{display:flex;align-items:center;gap:10px;color:#999;font-size:13px;letter-spacing:1.5px;text-transform:uppercase;font-family:'Poppins',sans-serif;font-weight:600}
  .gs-progress li .num{width:32px;height:32px;border-radius:50%;border:2px solid #ddd;display:flex;align-items:center;justify-content:center;font-size:14px;color:#999;transition:.3s;font-weight:700}
  .gs-progress li.done .num{background:#c8a96e;border-color:#c8a96e;color:#fff}
  .gs-progress li.current{color:#1a1a1a}
  .gs-progress li.current .num{border-color:#c8a96e;color:#c8a96e;font-weight:700}
  .gs-progress li:not(:last-child)::after{content:'';display:inline-block;width:36px;height:1px;background:#ddd;margin:0 14px}
  @media(max-width:600px){.gs-progress{gap:0}.gs-progress li span:not(.num){display:none}.gs-progress li:not(:last-child)::after{width:16px;margin:0 6px}}
  /* step panels */
  .gs-step{animation:gsFade .4s ease}
  @keyframes gsFade{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
  .gs-step h2{font-family:'Playfair',serif;font-size:32px;color:#1a1a1a;margin:0 0 14px;text-align:center}
  .gs-step > p.gs-sub{color:#4a4a4a;font-size:18px;line-height:1.8;text-align:center;max-width:560px;margin:0 auto 44px}
  /* premium card choices — replaces plain row list */
  .gs-wrap.is-cards{max-width:960px}
  .gs-card-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:20px}
  .gs-card{position:relative;text-align:left;background:#fff;border:2px solid #e7e2d6;padding:34px 32px 30px;cursor:pointer;font-family:'Poppins',sans-serif;transition:border-color .25s,box-shadow .25s,transform .25s;display:flex;flex-direction:column;gap:16px}
  .gs-card:hover{border-color:#c8a96e;box-shadow:0 22px 44px rgba(26,26,26,.09);transform:translateY(-3px)}
  .gs-card:focus-visible{outline:3px solid #8fa0c8;outline-offset:2px}
  .gs-card.selected{border-color:#c8a96e;background:linear-gradient(180deg,#fffdf9,#fdf9f0);box-shadow:0 22px 44px rgba(200,169,110,.22)}
  .gs-card .icon-wrap{width:54px;height:54px;border-radius:50%;background:#f9f5ef;display:flex;align-items:center;justify-content:center;color:#c8a96e;transition:background .25s,color .25s}
  .gs-card .icon-wrap svg{width:24px;height:24px;stroke:currentColor;fill:none;stroke-width:1.6}
  .gs-card:hover .icon-wrap,.gs-card.selected .icon-wrap{background:#c8a96e;color:#fff}
  .gs-card .gs-choice-title{font-family:'Playfair',serif;font-size:22px;color:#1a1a1a;line-height:1.3}
  .gs-card .gs-choice-desc{font-size:16px;color:#555;line-height:1.65}
  .gs-card .check{position:absolute;top:22px;right:22px;width:26px;height:26px;border-radius:50%;border:2px solid #ccc;transition:.2s}
  .gs-card.selected .check{border-color:#c8a96e;background:#c8a96e}
  .gs-card.selected .check::after{content:'';position:absolute;left:8px;top:4px;width:6px;height:11px;border:solid #fff;border-width:0 2.5px 2.5px 0;transform:rotate(45deg)}
  @media(max-width:700px){.gs-card-grid{grid-template-columns:1fr}}
  /* smaller multi-select cards, used for the services step */
  .gs-card-grid.gs-card-grid--sm{grid-template-columns:repeat(3,1fr)}
  .gs-card-grid--sm .gs-card{padding:24px 24px 22px;gap:12px}
  .gs-card-grid--sm .icon-wrap{width:44px;height:44px}
  .gs-card-grid--sm .icon-wrap svg{width:20px;height:20px}
  .gs-card-grid--sm .gs-choice-title{font-size:17px}
  .gs-card-grid--sm .gs-choice-desc{font-size:14px}
  .gs-card-grid--sm .check{top:18px;right:18px}
  @media(max-width:900px){.gs-card-grid--sm{grid-template-columns:repeat(2,1fr)}}
  @media(max-width:600px){.gs-card-grid--sm{grid-template-columns:1fr}}
  .gs-group-label{font-size:13px;letter-spacing:2px;text-transform:uppercase;color:#c8a96e;margin:40px 0 16px;display:flex;align-items:center;gap:14px;font-weight:700}
  .gs-group-label::after{content:'';flex:1;height:1px;background:#eee}
  .gs-group-label:first-child{margin-top:0}
  .gs-actions{display:flex;justify-content:space-between;align-items:center;margin-top:48px}
  .gs-actions.center{justify-content:center}
  .gs-back{background:none;border:none;color:#555;font-size:15px;letter-spacing:1px;cursor:pointer;font-family:'Poppins',sans-serif;padding:10px 6px}
  .gs-back:hover{color:#1a1a1a}
  .gs-continue{background:#c8a96e;color:#fff;border:none;padding:17px 38px;font-size:15px;letter-spacing:1.5px;text-transform:uppercase;cursor:pointer;font-weight:600;font-family:'Poppins',sans-serif;transition:.2s;border-radius:2px}
  .gs-continue:hover{background:#1a1a1a}
  .gs-continue:disabled{background:#e8e2d3;color:#fff;cursor:not-allowed}
  /* recommendation */
  .gs-rec{border:2px solid #eee;padding:36px}
  .gs-rec .rec-eyebrow{font-size:13px;letter-spacing:2px;text-transform:uppercase;color:#c8a96e;margin-bottom:10px;font-weight:700}
  .gs-rec h3{font-family:'Playfair',serif;font-size:28px;color:#1a1a1a;margin:0 0 4px}
  .gs-rec .rec-price{color:#888;font-size:15px;margin-bottom:16px}
  .gs-rec p{color:#444;line-height:1.8;font-size:16px}
  .gs-rec a.rec-link{display:inline-block;margin-top:6px;color:#c8a96e;font-size:14px;letter-spacing:1px;text-decoration:none;font-weight:700}
  .gs-rec a.rec-link:hover{color:#1a1a1a}
  .gs-note{background:#f9f5ef;border-left:4px solid #c8a96e;padding:18px 22px;font-size:15px;color:#3d4558;line-height:1.75;margin:26px 0}
  .gs-alt{text-align:center;color:#666;font-size:15px;margin-top:26px;line-height:1.8}
  .gs-alt a{color:#c8a96e;text-decoration:none;font-weight:700}
  .gs-alt a:hover{color:#1a1a1a}
  /* step 4 — details */
  .gs-summary{background:#f9f9f9;padding:24px 26px;font-size:15px;color:#444;line-height:1.85;margin-bottom:40px;border-left:4px solid #c8a96e}
  .gs-summary strong{color:#1a1a1a}
  .gs-summary button{background:none;border:none;color:#c8a96e;font-size:14px;text-decoration:underline;cursor:pointer;margin-top:10px;padding:0;font-family:'Poppins',sans-serif;font-weight:600}
  .form-group{margin-bottom:28px}
  .form-group label{display:block;font-size:15px;font-weight:700;color:#3d4558;margin-bottom:9px;letter-spacing:.2px}
  .form-group input,.form-group textarea{width:100%;padding:15px 2px;border:none;border-bottom:2px solid #ddd;font-size:18px;font-family:'Poppins',sans-serif;outline:none;box-sizing:border-box;background:transparent}
  .form-group input:focus,.form-group textarea:focus{border-color:#c8a96e}
  .form-group textarea{min-height:110px;resize:vertical}
  /* done */
  .gs-done{text-align:center;padding:20px 0}
  .gs-done .icon{width:64px;height:64px;border-radius:50%;background:#c8a96e;color:#fff;display:flex;align-items:center;justify-content:center;font-size:24px;margin:0 auto 26px}
  .gs-done h2{margin-bottom:14px}
  .gs-done p{color:#4a4a4a;font-size:17px;line-height:1.85;max-width:460px;margin:0 auto}
  @media(max-width:600px){.gs-hero h1{font-size:32px}.gs-hero p.gs-lead{font-size:16px}.gs-hero-call{width:100%;box-sizing:border-box;justify-content:center}.gs-wrap{padding:50px 20px 90px}.gs-step h2{font-size:25px}.gs-step>p.gs-sub{font-size:16px}.gs-rec{padding:26px}.gs-reassure .container{gap:16px 26px}.gs-card{padding:26px 22px 22px}.gs-actions{gap:16px}}
  @media(max-width:480px){
    .gs-hero h1{font-size:26px}
    .gs-progress li .num{width:26px;height:26px;font-size:12px}
    .gs-progress li:not(:last-child)::after{width:10px;margin:0 4px}
    .gs-actions{flex-wrap:wrap}
    .gs-actions:not(.center) .gs-back{order:2}
    .gs-actions:not(.center) .gs-continue{order:1;width:100%}
    .gs-continue{width:100%;box-sizing:border-box;text-align:center}
    .gs-card .gs-choice-title{font-size:19px}
    .gs-card-grid--sm .gs-choice-title{font-size:16px}
  }
  </style>
  <script src="/js/wp-includes_js_jquery_jquery.min.js"></script>
  <script src="/js/wp-includes_js_jquery_jquery-migrate.min.js"></script>
  <link rel="stylesheet" href="/css/chayce-nav.css">
