  .form-group input:focus,.form-group textarea:focus{border-color:var(--gold)}
  .form-group textarea{min-height:130px;resize:vertical}
  .btn-submit{background:var(--oxblood);color:#fff;border:none;padding:14px 36px;font-size:15px;letter-spacing:2px;text-transform:uppercase;cursor:pointer;width:100%}
  .btn-submit:hover{background:var(--oxblood-dark)}
  .news-card figure{overflow:hidden;margin-bottom:16px}
  .news-card figure img{width:100%;height:220px;object-fit:cover;transition:.4s}
  .news-card figure:hover img{transform:scale(1.05)}
  .news-card span{color:var(--gold);font-size:14px;letter-spacing:1px;text-transform:uppercase}
  .news-card h5{margin:8px 0;font-family:'Poppins',sans-serif;font-weight:500}
  .news-card h5 a{color:var(--ink);text-decoration:none}
  .news-card h5 a:hover{color:var(--gold)}
  .news-card p{color:var(--grey-mid);font-size:16px;line-height:1.7}
  .team-card{text-align:center;padding:30px 20px;border:1px solid var(--border-light)}
  .team-card .avatar{width:90px;height:90px;border-radius:50%;background:var(--gold);margin:0 auto 16px;display:flex;align-items:center;justify-content:center;font-size:32px;color:#fff;font-family:'Poppins',sans-serif;font-weight:500}
  .team-card h5{font-family:'Poppins',sans-serif;font-weight:500;color:var(--ink);margin-bottom:4px}
  .team-card p{color:var(--gold);font-size:14px;letter-spacing:2px;text-transform:uppercase}
  .faq-item{border-bottom:1px solid var(--border-light);padding:20px 0}
  .faq-item h5{color:var(--ink);font-size:16px;cursor:pointer}
  .faq-item p{color:var(--grey-mid);font-size:16px;line-height:1.7;margin-top:10px}
  table.pkg-table{width:100%;border-collapse:collapse}
  table.pkg-table th{background:var(--slate);color:#fff;padding:12px 16px;font-size:15px;letter-spacing:1px;text-align:left}
  table.pkg-table td{padding:12px 16px;border-bottom:1px solid var(--border-light);font-size:16px;color:#444}
  table.pkg-table tr:hover td{background:#fafafa}
  table.pkg-table td.gold{color:var(--gold);font-weight:500}
  .pkg-detail-head{max-width:640px;margin:0 auto 64px;text-align:center}
  .pkg-detail-eyebrow{font-size:14px;letter-spacing:2.5px;text-transform:uppercase;color:var(--gold);font-weight:500;margin:0 0 14px}
  .pkg-detail-title{font-family:'Playfair Display',serif;font-size:44px;color:var(--ink);margin:0 0 12px;line-height:1.2}
  .pkg-detail-sub{font-size:17px;color:var(--grey-mid);line-height:1.7;margin:0}
  .pkg-detail-banner{margin-bottom:64px;box-shadow:0 40px 80px rgba(26,26,26,.14);overflow:hidden}
  .pkg-detail-banner img{width:100%;max-height:520px;object-fit:cover;display:block}
  .pkg-detail-grid{display:grid;grid-template-columns:1.6fr 1fr;gap:64px;align-items:start}
  .pkg-section-label{font-size:14px;letter-spacing:2px;text-transform:uppercase;color:var(--grey-light);font-weight:500;margin:0 0 22px}
  .pkg-feature-list{list-style:none;padding:0;margin:0 0 40px}
  .pkg-feature-list li{display:flex;align-items:center;gap:16px;padding:14px 0;border-bottom:1px solid var(--border-light);color:var(--slate);font-size:17px}
  .pkg-feature-list li .badge{flex:0 0 34px;width:34px;height:34px;border-radius:50%;background:var(--bg-cream);display:flex;align-items:center;justify-content:center}
  .pkg-feature-list li .badge svg{width:15px;height:15px;stroke:var(--gold);fill:none;stroke-width:2.4;stroke-linecap:round;stroke-linejoin:round}
  .pkg-ideal-box{background:var(--bg-cream);border-left:3px solid var(--gold);padding:30px 34px;margin-bottom:8px}
  .pkg-ideal-box h4{font-family:'Poppins',sans-serif;font-weight:500;font-size:16px;color:var(--ink);margin:0 0 10px}
  .pkg-ideal-box p{margin:0;font-size:16.5px;color:#555;line-height:1.8}
  .pkg-order-card{position:sticky;top:112px;background:#fff;border:1px solid var(--border-warm);border-top:3px solid var(--ink);padding:40px 34px;box-shadow:0 30px 70px rgba(26,26,26,.1)}
  .pkg-order-card .oc-name{font-family:'Poppins',sans-serif;font-weight:500;font-size:24px;color:var(--ink);margin:0 0 14px}
  .pkg-order-card .oc-price{font-size:34px;font-weight:500;color:var(--gold);margin-bottom:26px}
  .btn-chayce{display:block;text-align:center;padding:16px 20px;background:var(--oxblood);color:#fff;text-decoration:none;font-size:15px;font-weight:500;letter-spacing:2px;text-transform:uppercase}
  .btn-chayce:hover{background:var(--oxblood-dark)}
  .pkg-order-card .oc-steps{margin:26px 0 0;padding:22px 0 0;border-top:1px solid var(--border-light)}
  .pkg-order-card .oc-step{display:flex;gap:12px;align-items:flex-start;font-size:15px;color:var(--grey-mid);line-height:1.6;margin-bottom:12px}
  .pkg-order-card .oc-step:last-child{margin-bottom:0}
  .pkg-order-card .oc-step .n{flex:0 0 20px;width:20px;height:20px;border-radius:50%;border:1px solid var(--gold-dark);color:var(--gold-dark);font-size:13px;font-weight:500;display:flex;align-items:center;justify-content:center}
  .pkg-cross-link{margin-top:22px;padding-top:18px;border-top:1px solid var(--border-light);font-size:15px;color:var(--grey-light);line-height:1.6}
  .pkg-cross-link a{color:var(--gold);font-weight:500;text-decoration:none}
  .pkg-cross-link a:hover{color:var(--ink)}
  @media(max-width:900px){.pkg-detail-grid{grid-template-columns:1fr}.pkg-order-card{position:static}}
  @media(max-width:768px){.contact-grid{grid-template-columns:1fr}.icon-item{flex:0 0 100%}}
  @media(max-width:600px){
  .pkg-detail-title{font-size:28px}
  .pkg-detail-sub{font-size:17px}
  .pkg-ideal-box{padding:22px 20px}
  .pkg-order-card{padding:28px 22px}
  .pkg-feature-list li{font-size:16px;gap:12px}
  }
  /* ===== Package FAQ ===== */
  .pkg-faq-band{background:var(--bg-warm);padding:80px 0}
  .pkg-faq-band .container{max-width:760px}
  .pkg-faq-band h2{font-family:'Playfair Display',serif;font-size:28px;color:var(--ink);margin:0 0 30px;text-align:center}
  .pkg-faq{margin:0}
  .pkg-faq details{border-bottom:1px solid var(--border-warm-2);padding:20px 0}
  .pkg-faq details:first-child{border-top:1px solid var(--border-warm-2)}
  .pkg-faq summary{list-style:none;cursor:pointer;display:flex;align-items:center;justify-content:space-between;gap:18px;font-family:'Poppins',sans-serif;font-weight:500;font-size:17px;color:var(--ink);font-weight:500}
  .pkg-faq summary::-webkit-details-marker{display:none}
  .pkg-faq summary::after{content:'+';flex-shrink:0;font-family:'Poppins',sans-serif;font-size:19px;font-weight:400;color:var(--gold-dark)}
  .pkg-faq details[open] summary::after{content:'\2212'}
  .pkg-faq p{color:var(--grey-mid);font-size:17px;line-height:1.8;margin:12px 0 0}
  /* ===== Discovery walkthrough / client journey timeline ===== */
  .pkg-journey{margin:0 0 56px}
  .pkg-journey h3{font-family:'Poppins',sans-serif;font-weight:500;font-size:22px;color:var(--ink);margin:0 0 26px}
  .pkg-journey-steps{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:22px}
  .pkg-journey-steps li{display:flex;gap:18px;align-items:flex-start}
  .pkg-journey-steps .jn{flex:0 0 30px;width:30px;height:30px;border-radius:50%;background:var(--ink);color:#fff;font-size:15px;font-weight:500;display:flex;align-items:center;justify-content:center;font-family:'Poppins',sans-serif;font-weight:500}
  .pkg-journey-steps .jt strong{display:block;color:var(--ink);font-size:17px;font-weight:500;margin-bottom:3px}
  .pkg-journey-steps .jt span{color:var(--grey-mid);font-size:16px;line-height:1.7}
  /* ===== Composite case study ===== */
  .client-story{background:var(--bg-cream-deep);border:1px solid var(--border-warm-3);padding:36px 40px}
  .client-story h3{font-family:'Poppins',sans-serif;font-weight:500;font-size:21px;color:var(--ink);margin:0 0 12px}
  .client-story p{color:#555;font-size:17px;line-height:1.8;margin:0 0 12px}
  .client-story p:last-child{margin-bottom:0}
  .client-story blockquote{margin:0;padding:0}
  .client-story blockquote p{font-family:'Poppins',sans-serif;font-size:17px;line-height:1.85;color:var(--ink);margin:0 0 16px}
  .client-story blockquote cite{display:block;font-style:normal;font-size:15px;color:var(--gold-dark);letter-spacing:.3px;font-weight:500}
  .client-story .sc-byline{display:flex;align-items:center;gap:13px;margin-top:18px}
  .client-story .sc-byline .sc-mark{flex:0 0 36px;width:36px;height:36px;border-radius:50%;background:var(--ink);color:#fff;font-family:'Poppins',sans-serif;font-weight:500;font-size:14px;font-weight:500;display:flex;align-items:center;justify-content:center}
  .client-story .sc-byline .sc-who{display:flex;flex-direction:column}
  .client-story .sc-byline .sc-who b{font-size:15.5px;color:var(--ink);font-weight:500}
  .client-story .sc-byline .sc-who span{font-size:13px;color:var(--grey-light);letter-spacing:.3px}
  .client-story blockquote{position:relative}
  .client-story .qmark{position:absolute;top:-10px;right:0;font-family:'Playfair Display',serif;font-size:60px;color:var(--border-warm-3);line-height:1;pointer-events:none}
  @media(max-width:600px){.client-story{padding:26px 24px}.pkg-journey-steps{gap:18px}.client-story blockquote p{font-size:17px}}
  /* ===== Why start here ===== */
  .why-start-row{display:grid;grid-template-columns:repeat(3,1fr);gap:32px;max-width:900px;margin:0 auto}
  .why-start-item .num{display:inline-flex;align-items:center;justify-content:center;width:36px;height:36px;border-radius:50%;background:var(--bg-cream-deep);color:var(--gold-dark);font-family:'Poppins',sans-serif;font-weight:500;font-size:15px;font-weight:500;margin-bottom:14px}
  .why-start-item h4{font-family:'Poppins',sans-serif;font-weight:500;font-size:17px;color:var(--ink);margin:0 0 6px}
  .why-start-item p{color:var(--grey-mid);font-size:16px;line-height:1.7;margin:0}
  @media(max-width:700px){.why-start-row{grid-template-columns:1fr}}
  /* ===== Closing CTA ===== */
  .pkg-close-cta{background:var(--bg-cream);padding:70px 0;text-align:center}
  .pkg-close-cta h2{font-family:'Playfair Display',serif;font-size:28px;color:var(--ink);margin:0 0 12px}
  .pkg-close-cta p{color:var(--grey-mid);font-size:17px;margin:0 0 26px}
  .pkg-close-cta .btn-row{display:flex;gap:16px;flex-wrap:wrap;justify-content:center}
  .pkg-close-cta .btn-row a{display:inline-block;padding:15px 32px;font-size:15px;font-weight:500;letter-spacing:1.5px;text-transform:uppercase;text-decoration:none;border-radius:2px}
  .pkg-close-cta .btn-row .primary{background:var(--oxblood);color:#fff}
  .pkg-close-cta .btn-row .primary:hover{background:var(--oxblood-dark)}
  .pkg-close-cta .btn-row .ghost{background:transparent;color:var(--ink);border:1px solid var(--ink)}
  .pkg-close-cta .btn-row .ghost:hover{background:var(--ink);color:#fff}
  @media(max-width:480px){.pkg-close-cta .btn-row{flex-direction:column}.pkg-close-cta .btn-row a{width:100%;box-sizing:border-box}}

