<script>
(function(){
  var cards=document.querySelectorAll('.topic-card');
  function update(c){
    var ul=c.querySelector('ul');
    var more=ul.scrollHeight>ul.clientHeight+4;
    c.classList.toggle('can-scroll',more);
    c.classList.toggle('at-end',ul.scrollTop+ul.clientHeight>=ul.scrollHeight-4);
  }
  cards.forEach(function(c){
    var hint=document.createElement('div');
    hint.className='topic-more';hint.setAttribute('aria-hidden','true');
    hint.innerHTML='Scroll for more <i>&darr;</i>';
    c.appendChild(hint);
    var ul=c.querySelector('ul');
    ul.addEventListener('scroll',function(){update(c)},{passive:true});
    update(c);
  });
  window.addEventListener('resize',function(){cards.forEach(update)});
})();
</script>
