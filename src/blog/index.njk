<script type="application/ld+json">
{"@type":"BreadcrumbList","@context":"https://schema.org","itemListElement":[{"item":"https://chayceproperties.com/","name":"Home","@type":"ListItem","position":1},{"item":"https://chayceproperties.com/blog/","name":"Blog","@type":"ListItem","position":2}]}
</script>
<div class="page-hero" style="background-image:url({% imageUrl "chayce-blog-hero.webp" %});{% imageSet "chayce-blog-hero.webp" %};background-size:cover;background-position:center;">
  <div class="container">
    <p class="breadcrumb"><a href="/">Home</a> / <em>Blog</em></p>
    <h1><em>Chayce</em> Blog</h1>
    <p style="color:#ccc;margin-top:10px;font-size:16px;">Insights on senior relocation, downsizing, and moving with Chayce Properties</p>
  </div>
</div>

<section class="page-section">
  <div class="container">
    {% if collections.blog.length > 0 %}
    <div class="row">
      {% for post in collections.blog | reverse %}
      <div class="col-md-4">
        <div class="news-card" style="margin-bottom:40px">
          {% if post.data.featuredImage %}
          <figure><img src="{{ post.data.featuredImage }}" alt="{{ post.data.featuredImageAlt | default(post.data.title) }}" width="940" height="650"></figure>
          {% endif %}
          <span>{{ post.date | readableDate }}</span>
          <h5><a href="{{ post.url }}">{{ post.data.title }}</a></h5>
          {% if post.data.description %}<p>{{ post.data.description }}</p>{% endif %}
          <a href="{{ post.url }}" style="color:#c8a96e;font-size:13px;letter-spacing:1px;text-transform:uppercase;text-decoration:none">Read More &rsaquo;</a>
        </div>
      </div>
      {% endfor %}
    </div>
    {% else %}
    <p style="color:#666;text-align:center;">New posts are coming soon.</p>
    {% endif %}
  </div>
</section>

