---
layout: base.njk
ogType: "article"
headExtra: |
  <link rel="stylesheet" href="/css/chayce-nav.css?v={{ build.version }}">
  <link rel="stylesheet" href="/css/chayce-blog.css?v={{ build.version }}">
---
{# =====================================================
   BLOG POST LAYOUT — Chayce Properties
   Same page-hero / news-card visual language as /news/
   (src/css/chayce-blog.css, copied from that page's own CSS)
   ===================================================== #}
<script type="application/ld+json">
{"@type":"BreadcrumbList","@context":"https://schema.org","itemListElement":[{"item":"https://chayceproperties.com/","name":"Home","@type":"ListItem","position":1},{"item":"https://chayceproperties.com/blog/","name":"Blog","@type":"ListItem","position":2},{"item":"https://chayceproperties.com{{ page.url }}","name":{{ title | dump | safe }},"@type":"ListItem","position":3}]}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "@id": "https://chayceproperties.com{{ page.url }}#article",
  "headline": {{ title | dump | safe }},
  "description": {{ description | default('') | dump | safe }},
  {#- featuredImage is always an absolute remote URL (Pexels) here, never a
     site-relative path — no schemaImage prefixing needed, unlike a site that
     mixes hand-written local images with remote ones. #}
  "image": {{ (featuredImage | default('https://chayceproperties.com/images/chayce-logo.png')) | dump | safe }},
  "datePublished": "{{ date }}",
  "dateModified": "{{ dateModified | default(date) }}",
{% if about %}  "about": [{% for e in about %}{"@type":"Thing","name":{{ e.name | dump | safe }},"sameAs":{{ e.url | dump | safe }}}{% if not loop.last %},{% endif %}{% endfor %}],
{% endif %}{% if sources %}  "citation": [{% for c in sources %}{"@type":"CreativeWork","name":{{ c.name | dump | safe }},"url":{{ c.url | dump | safe }}}{% if not loop.last %},{% endif %}{% endfor %}],
{% endif %}  "author": { "@type": "Organization", "@id": "{{ site.url }}/#organization", "name": "{{ site.name }}", "url": "{{ site.url }}/about-chayce/" },
  "publisher": { "@type": "Organization", "@id": "{{ site.url }}/#organization", "name": "{{ site.name }}", "logo": { "@type": "ImageObject", "url": "{{ site.url }}/images/chayce-logo.png", "width": 240, "height": 160 } },
  "inLanguage": "en-GB",
  "mainEntityOfPage": { "@type": "WebPage", "@id": "https://chayceproperties.com{{ page.url }}" }
}
</script>
{% if faq %}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{% for item in faq %}{"@type":"Question","name":{{ item.q | dump | safe }},"acceptedAnswer":{"@type":"Answer","text":{{ item.a | dump | safe }}}}{% if not loop.last %},{% endif %}{% endfor %}]}
</script>
{% endif %}
{% if howTo %}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"HowTo","name":{{ howTo.name | dump | safe }},"step":[{% for s in howTo.steps %}{"@type":"HowToStep","name":{{ s.name | dump | safe }},"text":{{ s.text | dump | safe }}}{% if not loop.last %},{% endif %}{% endfor %}]}
</script>
{% endif %}

<div class="page-hero--article">
  <div class="container">
    <p class="breadcrumb"><a href="/">Home</a> / <a href="/blog/">Blog</a> / <em>{{ title | truncate(40) }}</em></p>
    <h1>{{ title }}</h1>
    {% if description %}<p style="color:var(--grey-mid);margin-top:10px;font-size:16px;max-width:640px">{{ description }}</p>{% endif %}
  </div>
</div>

<section class="page-section">
  <div class="container">
    <div class="row">
      <div class="col-md-8">
        <p class="blog-post-meta">
          <time datetime="{{ date }}">{{ date | readableDate }}</time>
          <span>{{ content | readTime }} min read</span>
          {% if dateModified and dateModified != date %}<span>Updated <time datetime="{{ dateModified }}">{{ dateModified | readableDate }}</time></span>{% endif %}
        </p>

        {% if featuredImage %}
        <img class="blog-post-hero-image" src="{{ featuredImage }}" alt="{{ featuredImageAlt | default(title) }}" width="940" height="650">
        {% endif %}

        <div class="blog-post-body">
          {{ content | safe }}
        </div>

        {% if faq %}
        <div class="blog-post-faq">
          <h2 style="color:var(--ink);font-family:'Playfair Display',serif;font-size:28px;margin:44px 0 18px">Common questions</h2>
          {% for item in faq %}
          <h3 style="color:var(--ink);font-family:'Poppins',sans-serif;font-weight:500;font-size:18px;margin:22px 0 8px">{{ item.q }}</h3>
          <p style="color:#444;font-size:16px;line-height:1.8;margin:0">{{ item.a }}</p>
          {% endfor %}
        </div>
        {% endif %}
      </div>

      <div class="col-md-4">
        <div class="blog-sidebar">
          <div class="card-box">
            <h4>Planning a <em>move?</em></h4>
            <p>Chayce Properties is a Northampton-based later-life moving service. New here? See <a href="/senior-move-manager-uk/">what a senior move manager does</a>, <a href="/downsizing-help-for-elderly/">downsizing help for older people</a>, or <a href="/moving-elderly-parent/">moving an elderly parent</a>. Prices are on the <a href="/packages/">packages page</a>.</p>
            <a href="/discovery/" class="btn-chayce">Book a Discovery Consultation</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% set relatedPosts = collections.blog | relatedPosts(page.url, 3) %}
{% if relatedPosts.length > 0 %}
<section class="page-section grey">
  <div class="container">
    <h3 style="font-family:'Playfair Display',serif;color:#1a1a1a;margin-bottom:30px;">More from Chayce</h3>
    <div class="row">
      {% for post in relatedPosts %}
      <div class="col-md-4">
        <div class="news-card" style="margin-bottom:40px">
          {% if post.data.featuredImage %}
          <figure><img src="{{ post.data.featuredImage }}" alt="{{ post.data.featuredImageAlt | default(post.data.title) }}" width="940" height="650"></figure>
          {% endif %}
          <span>{{ post.date | readableDate }}</span>
          <h5><a href="{{ post.url }}">{{ post.data.title }}</a></h5>
          {% if post.data.description %}<p>{{ post.data.description }}</p>{% endif %}
          <a href="{{ post.url }}" style="color:#c8a96e;font-size:13px;letter-spacing:1px;text-transform:uppercase;text-decoration:none">Read More &rsaquo;</a>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}
