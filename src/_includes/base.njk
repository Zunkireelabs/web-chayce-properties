<!DOCTYPE html>
<html lang="en-US">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<!-- Google Analytics (prod only: chayceproperties.com) -->
<script>
if (/^(www\.)?chayceproperties\.com$/.test(location.hostname)) {
  var ga = document.createElement('script');
  ga.async = true;
  ga.src = 'https://www.googletagmanager.com/gtag/js?id=G-RXT1PVN3Z0';
  document.head.appendChild(ga);
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-RXT1PVN3Z0');
}
</script>
<title>{{ title | safe }}</title>
{% if description %}<meta name="description" content="{{ description | safe }}">{% endif %}
<link rel="canonical" href="{{ canonicalUrl or ('https://chayceproperties.com' + page.url) }}">
<link rel="icon" type="image/png" href="/images/favicon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:type" content="{{ ogType or 'website' }}">
<meta property="og:title" content="{{ ogTitle or title | safe }}">
{% if description %}<meta property="og:description" content="{{ description | safe }}">{% endif %}
<meta property="og:url" content="{{ canonicalUrl or (site.url + page.url) }}">
<meta property="og:image" content="{{ ogImage or featuredImage or site.defaultOgImage }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ ogTitle or title | safe }}">
{% if description %}<meta name="twitter:description" content="{{ description | safe }}">{% endif %}
<link rel="stylesheet" href="/css/wp-content_themes_hompark_css_bundle.min.css">
<link rel="stylesheet" href="/css/wp-content_themes_hompark_css_bootstrap.min.css">
<link rel="stylesheet" href="/css/wp-content_themes_hompark_css_style.css">
<link rel="stylesheet" href="/css/wp-content_themes_hompark_css_fontawesome.min.css">
<link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Poppins:400,600,800">
<link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Playfair">
<link rel="stylesheet" href="/css/seoai-content.css">
<link rel="stylesheet" href="/css/chayce-tokens.css">
{{ headExtra | safe }}
<!-- SEOAI:HEAD:START --><!-- SEOAI:HEAD:END -->
</head>
<body class="{{ bodyClass }}">
{% include "nav.njk" %}

{{ content | safe }}

{% include "footer.njk" %}
{{ footScripts | safe }}
</body></html>
