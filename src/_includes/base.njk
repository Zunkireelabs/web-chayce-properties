<!DOCTYPE html>
<html lang="en-GB">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{% if page.url == "/" %}<meta name="trustpilot-one-time-domain-verification-id" content="eec9d0ec-4271-40c0-915d-e80f8aa529eb"/>{% endif %}
<!-- Google Analytics (prod only: chayceproperties.com) -->
<script>
if (/^(www\.)?chayceproperties\.com$/.test(location.hostname)) {
  var ga = document.createElement('script');
  ga.async = true;
  ga.src = 'https://www.googletagmanager.com/gtag/js?id=G-RXT1PVN3Z0';
  document.head.appendChild(ga);
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-RXT1PVN3Z0');
}
</script>
<title>{{ title | safe }}</title>
{% if description %}<meta name="description" content="{{ description | safe }}">{% endif %}
<link rel="canonical" href="{{ canonicalUrl or ('https://chayceproperties.com' + page.url) }}">
<link rel="alternate" hreflang="en-GB" href="{{ canonicalUrl or (site.url + page.url) }}">
<link rel="alternate" hreflang="x-default" href="{{ canonicalUrl or (site.url + page.url) }}">
<meta name="robots" content="{{ robots or 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1' }}">
<meta name="geo.region" content="GB-NTH">
<meta name="geo.placename" content="Northampton">
<meta name="geo.position" content="{{ site.geo.latitude }};{{ site.geo.longitude }}">
<meta name="ICBM" content="{{ site.geo.latitude }}, {{ site.geo.longitude }}">
<link rel="icon" type="image/png" href="/images/favicon.png">
<link rel="alternate" type="application/atom+xml" title="Chayce Properties Blog" href="/feed.xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<meta property="og:locale" content="en_GB">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:type" content="{{ ogType or 'website' }}">
<meta property="og:title" content="{{ ogTitle or title | safe }}">
{% if description %}<meta property="og:description" content="{{ description | safe }}">{% endif %}
<meta property="og:url" content="{{ canonicalUrl or (site.url + page.url) }}">
<meta property="og:image" content="{{ ogImage or featuredImage or site.defaultOgImage }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content="{{ ogImage or featuredImage or site.defaultOgImage }}">
<meta name="twitter:title" content="{{ ogTitle or title | safe }}">
{% if description %}<meta name="twitter:description" content="{{ description | safe }}">{% endif %}
<link rel="stylesheet" href="/css/wp-content_themes_hompark_css_bundle.min.css">
<link rel="stylesheet" href="/css/wp-content_themes_hompark_css_bootstrap.min.css">
<link rel="stylesheet" href="/css/wp-content_themes_hompark_css_style.css">
<link rel="stylesheet" href="/css/wp-content_themes_hompark_css_fontawesome.min.css">
<link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Poppins:400,600,800&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;0,800;0,900;1,500;1,600&display=swap">
<link rel="stylesheet" href="/css/seoai-content.css">
<link rel="stylesheet" href="/css/chayce-tokens.css">
<link rel="stylesheet" href="/css/chayce-hero-variants.css">
<link rel="stylesheet" href="/css/chayce-sticky-cta.css">
{{ headExtra | safe }}
<!-- SEOAI:HEAD:START --><!-- SEOAI:HEAD:END -->
</head>
<body class="{{ bodyClass }}">
{% include "nav.njk" %}

{{ content | safe }}

{% include "footer.njk" %}
<div class="sticky-cta" role="navigation" aria-label="Quick contact">
  <a href="tel:+447708925432" data-cta="call">Call</a>
  <a href="https://wa.me/447708925432" data-cta="whatsapp" rel="noopener">WhatsApp</a>
  <a href="/get-started/" data-cta="get-started">Get Started</a>
</div>
<script>
document.addEventListener('click', function (e) {
  var a = e.target.closest && e.target.closest('a[href^="tel:"],a[href*="wa.me/"],a[href="/get-started/"]');
  if (!a || typeof gtag !== 'function') return;
  var h = a.getAttribute('href');
  var method = h.indexOf('tel:') === 0 ? 'call' : (h.indexOf('wa.me') > -1 ? 'whatsapp' : 'get_started');
  gtag('event', 'contact_click', { method: method, page_path: location.pathname });
});
</script>
{{ footScripts | safe }}
</body></html>
