{% macro guideCards(posts, urls) %}<div class="rx-guides">{% for u in urls %}{% for p in posts %}{% if p.url == u %}<a class="rx-guide" href="{{ p.url }}">{{ p.data.featuredImage | blogPicture(p.data.featuredImageAlt or p.data.title, "(max-width: 600px) 100vw, 250px") | safe }}<span>{{ p.data.title }}</span></a>{% endif %}{% endfor %}{% endfor %}</div>{% endmacro %}
