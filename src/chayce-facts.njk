---
permalink: "chayce-facts.json"
eleventyExcludeFromCollections: true
---
{
  "name": "Chayce Properties",
  "legalName": "Chayce Properties Ltd",
  "type": "Later-life moving, downsizing and relocation service",
  "founded": 2026,
  "url": "https://chayceproperties.com/",
  "description": "Northampton-based later-life moving and downsizing service helping older people and their families move home across the UK with one dedicated coordinator.",
  "address": {
    "streetAddress": "{{ site.address.streetAddress }}",
    "locality": "{{ site.address.addressLocality }}",
    "postalCode": "{{ site.address.postalCode }}",
    "country": "GB"
  },
  "telephone": "{{ site.telephone }}",
  "email": "{{ site.email }}",
  "openingHours": "Mo-Fr 09:00-17:30",
  "areaServed": [
    "Northampton",
    "Northamptonshire",
    "East Midlands",{% for area in localAreas %}
    "{{ area.name }}",{% endfor %}
    "United Kingdom"
  ],
  "companyNumber": "{{ site.companiesHouseNumber }}",
  "registeredIn": "{{ site.registeredCountry }}",
  "lastReviewed": "{{ site.lastReviewed }}",
  "trust": {
    "dbsCheckedStaff": {{ "true" if site.trust.dbsCheckedStaff else "false" }},
    "dbsLevel": "{{ site.trust.dbsLevel }}{% if site.trust.dbsBarredList %} including barred list check{% endif %}",
    "insurance": {{ site.trust.insurance | dump | safe }},
    "page": "https://chayceproperties.com/trust-and-safeguarding/"
  },
  "insured": "Every removal is fully insured against loss or damage in transit. Details are set out in the service agreement before the move begins.",
  "pricing": "Package prices are published on the website at https://chayceproperties.com/packages/.",
  "team": "Our own vetted team, not outsourced.",
  "whatsapp": "https://wa.me/447708925432",
  "notAnEstateAgent": true,
  "services": [
    "Sorting and decluttering",
    "Packing and unpacking",
    "Insured removals",
    "Estate agent and solicitor liaison",
    "Property staging",
    "Storage",
    "Deep cleaning",
    "Settling-in support"
  ],
  "packages": [
{%- for p in site.packages %}
    { "name": "{{ p.name }}", "fromPriceGBP": {{ p.price }}, "url": "{{ site.url }}{{ p.url }}/" }{% if not loop.last %},{% endif %}
{%- endfor %}
  ],
  "keyPages": {
    "caseStudies": "https://chayceproperties.com/case-studies/",
    "seniorMoveManager": "https://chayceproperties.com/elderly-move-manager-uk/",
    "about": "https://chayceproperties.com/about-chayce/",
    "faq": "https://chayceproperties.com/elderly-removals-faq/",
    "llms": "https://chayceproperties.com/llms.txt",
    "trustAndSafeguarding": "https://chayceproperties.com/trust-and-safeguarding/",
    "storage": "https://chayceproperties.com/storage-during-your-move/"
  },
  "blogGuides": {{ collections.blog | length }}
}
